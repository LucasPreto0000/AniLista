{
  "manifest_version": 3,
  "name": "AniLista · Anitsu",
  "version": "1.0.0",
  "description": "Pesquisa no Anitsu usando sua sessão e abre a pasta encontrada pelo AniLista.",
  "key": "",
  "permissions": ["nativeMessaging", "scripting", "tabs"],
  "host_permissions": ["https://nuvem.anitsu.moe/*", "https://anitsu.moe/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Conectar ao AniLista (mantenha o app aberto)"}
}
